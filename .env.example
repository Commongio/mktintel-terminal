# Template only. Never put real values in this file -- it is the one .env the
# repo commits, and this repo is public.
#
# Copy to .env.local and fill in. Vercel holds the live values under
# Settings -> Environment Variables.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role. Server-side only -- it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# ── market data ─────────────────────────────────────────────────────────────
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=

# ── auth ────────────────────────────────────────────────────────────────────
ACCESS_CODES=
OWNER_EMAILS=
# Local convenience. Must stay unset in any deployed environment.
NEXT_PUBLIC_DEV_BYPASS_AUTH=

# ── cron ────────────────────────────────────────────────────────────────────
# Authenticates the scan workflow against /api/cron/generate-signals.
CRON_SECRET=

# ── push ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── KRONOS Lab bridge ───────────────────────────────────────────────────────
# Both must be present or the emitter is inert -- it is never half-on, because
# a half-configured emitter fails silently and looks exactly like a working one
# with nothing to report.
#
# No trailing slash: `${KRONOS_LAB_URL}/api/ingest` with one yields a double
# slash, which some routers 404. That failure is swallowed by the emitter's
# fire-and-forget catch, so it presents as complete silence.
KRONOS_LAB_URL=
# Must be byte-identical to the Lab's copy, or every event is rejected as
# unsigned. Generate once, paste into both, never into a terminal history.
KRONOS_LAB_HMAC_KEY=
KRONOS_LAB_KEY_ID=k1
